{
    "name": "seba1rx/sessionadmin",
    "description": "PHP session management with security hardening, hijacking detection, and URL authorization for MPA and SPA applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Basilio",
            "email": "seba1rx@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\": "src/",
            "Seba1rx\\SessionAdmin\\Build\\": "build/"
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off phpunit --colors=always",
        "coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-text --coverage-html=coverage --coverage-clover=coverage/clover.xml"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
