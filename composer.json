{
    "name": "seba1rx/sessionadmin",
    "description": "php session admin featuring url control and security against hijicking",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Basilio",
            "email": "seba1rx@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\": "src/",
            "Seba1rx\\SessionAdmin\\Exceptions\\": "Exceptions/",
            "Seba1rx\\SessionAdmin\\Build\\": "build/"
        },
        "files": [
            "bin/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "XDEBUG_MODE=off phpunit --colors=always",
        "coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-text --coverage-html=coverage --coverage-clover=coverage/clover.xml",
        "publish-assets": [
            "Seba1rx\\SessionAdmin\\Build\\SessionAdminPlugin::publishAssets"
        ]
    },
    "extra": {
        "class": "Seba1rx\\SessionAdmin\\Build\\SessionAdminPlugin",
        "publish": {
            "assets/seba1rx_sessionAdmin.js": "seba1rx_sessionAdmin.js"
        }
    },
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "*",
        "composer/composer": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
