{
    "name": "seba1rx/sessionadmin",
    "description": "php session admin featuring url control and security against hijicking",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Basilio",
            "email": "seba1rx@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "post-install-cmd": [
            "Seba1rx\\ComposerScripts::publishAssets",
            "php -r \"copy(__DIR__.'/script/seba1rx_sessionadmin.js', getcwd().'/seba1rx_sessionadmin.js');\""
        ],
        "post-update-cmd": [
            "Seba1rx\\ComposerScripts::publishAssets"
        ],
        "publish-assets": [
            "Seba1rx\\ComposerScripts::publishAssets"
        ]
    },
    "extra": {
        "publish": {
            "scripts/seba1rx_sessionAdmin.js": "seba1rx_sessionAdmin.js"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Seba1rx\\SessionAdmin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
