{
    "name": "seba1rx/sessionadmin-tabmanager-demo",
    "description": "Demo: seba1rx/sessionadmin + seba1rx/tabmanager integration",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../"
        },
        {
            "type": "path",
            "url": "/home/legion/dev/proyectos/tabmanager"
        }
    ],
    "require": {
        "php": ">=8.1",
        "seba1rx/sessionadmin": "*@dev",
        "seba1rx/tabmanager": "*@dev"
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"copy('vendor/seba1rx/tabmanager/assets/seba1rx_tabmanagerclient.js', 'seba1rx_tabmanagerclient.js');\""
        ],
        "post-update-cmd": [
            "php -r \"copy('vendor/seba1rx/tabmanager/assets/seba1rx_tabmanagerclient.js', 'seba1rx_tabmanagerclient.js');\""
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "config": {
        "allow-plugins": {
            "seba1rx/sessionadmin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": false
}
